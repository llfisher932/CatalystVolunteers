enum ApprovalStatus {
  PENDING
  APPROVED
  DISAPPROVED
  INACTIVE
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  name     String
}

model Volunteer {
  id                    Int            @id @default(autoincrement())
  firstName             String
  lastName              String
  username              String         @unique // we have no volunteer login, but this is in the requirements
  password              String // we have no volunteer login, but this is in the requirements
  email                 String         @unique
  address               String?
  homePhone             String?
  workPhone             String?
  cellPhone             String?
  educationalBackground String?
  currentLicenses       String?
  skills                String[] // Skills/Interests
  availability          String? // Availability times — see notes
  approvalStatus        ApprovalStatus @default(PENDING)

  // Emergency contact
  emergencyName      String?
  emergencyHomePhone String?
  emergencyWorkPhone String?
  emergencyEmail     String?
  emergencyAddress   String?

  // Documents on file
  driversLicenseOnFile Boolean @default(false)
  socialSecurityOnFile Boolean @default(false)

  //preferredCenters Center[] @relation("VolunteerPreferredCenters")
  //matches          Match[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
