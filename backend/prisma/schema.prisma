enum ApprovalStatus {
  PENDING
  APPROVED
  DISAPPROVED
  INACTIVE
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  username String @unique
  password String
}

model Volunteer {
  id                    Int            @id @default(autoincrement())
  firstName             String
  lastName              String
  username              String         @unique // we have no volunteer login, but this is in the requirements
  password              String // we have no volunteer login, but this is in the requirements
  email                 String         @unique
  address               String?
  homePhone             String?
  workPhone             String?
  cellPhone             String?
  educationalBackground String?
  currentLicenses       String?
  skills                String[] // Skills/Interests
  availability          String? // free text for now; would need a structured model if it ever drives matching
  approvalStatus        ApprovalStatus @default(PENDING)

  // Emergency contact
  emergencyName      String?
  emergencyHomePhone String?
  emergencyWorkPhone String?
  emergencyEmail     String?
  emergencyAddress   String?

  // Documents on file
  driversLicenseOnFile Boolean @default(false)
  socialSecurityOnFile Boolean @default(false)

  preferredCenters String[] // arbitrary location names, not a managed entity
  matches          Match[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Opportunity {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  center      String
  matches     Match[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([center])
  @@index([createdAt])
}

model Match {
  volunteerId   Int
  opportunityId Int
  volunteer     Volunteer   @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  matchedAt     DateTime    @default(now())

  @@id([volunteerId, opportunityId]) // composite primary key
  @@index([opportunityId])
}
